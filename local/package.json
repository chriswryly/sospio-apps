{
  "name": "sospio-local",
  "version": "0.1.0",
  "productName": "Sospio Chat",
  "private": true,
  "license": "Apache-2.0",
  "description": "Sospio chat app with a remote conversation monitor.",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && node ../scripts/dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:leaks": "node --test ../tests/release_leak.test.mjs && vitest run src/main/__tests__/credential_leak.test.ts src/main/__tests__/hostedChatClient.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "electron": "^45.2.2",
    "electron-builder": "26.18.0",
    "@electron/asar": "3.4.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-vite": "^2.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
