{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@sospio/cockpit": [
        "../cockpit/src/index.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "vitest": [
        "./node_modules/vitest"
      ],
      "vitest/*": [
        "./node_modules/vitest/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "../cockpit/src",
    "../shared/**/*.ts",
    "../records/**/*.ts"
  ]
}
